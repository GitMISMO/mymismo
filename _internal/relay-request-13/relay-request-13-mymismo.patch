+async function mmVerify(event, proj, headers) {
+  const pre = mmPre(event, proj, headers); if (pre.error) return pre.error;
+  const b = pre.body, now = Date.now();
+  if (!mmAllowed('verify', mmIp(event), MM_LIMITS.verify, now)) return respond(429, { error: 'TOO_MANY', message: 'Too many tries from here. Please wait a few minutes.' });
+  const email = mmStr(b.email, 254).toLowerCase(), summit = mmStr(b.summit, 31), code = mmStr(b.code, 12).replace(/\s+/g, '');
+  const wrong = respond(401, { error: 'WRONG_CODE', message: 'That code isn’t right, or it has expired. Ask for a new one.' });
+  if (!mmEmailOk(email) || !MM_SUMMIT.test(summit) || !/^\d{6}$/.test(code)) return wrong;
+  const id = mmIdOf(summit, email);
+  let good = false, refused = null;
+  const w = await updateRepoJson(proj.repo, proj.branch || 'main', MM_CODES, d => {
+    d.docs = d.docs && typeof d.docs === 'object' && !Array.isArray(d.docs) ? d.docs : {};
+    const c = d.docs[id];
+    if (!c || !(c.exp > now) || c.tries >= MM_CODE_TRIES || c.s !== summit) { refused = wrong; throw new Error('stop'); }
+    if (hashesMatch(c.h, mmHash(code))) { good = true; delete d.docs[id]; }   /* a code works once */
+    else c.tries = (c.tries || 0) + 1;
+    return d;
+  }, 'MyMISMO sign-in').catch(() => (refused ? { refused: true } : { error: 'THROWN' }));
+  if (refused) return refused;
+  if (!w || w.error) return respond(502, { error: 'UNAVAILABLE', message: 'Sign-in is briefly unavailable. Please try again in a minute.' });
+  if (!good) return wrong;
+  const feed = await mmFeed(proj); const s = !feed.error && feed.summits[summit], person = s && s.people.get(email);
+  if (!person) return wrong;
+  /* first sign-in makes their entry, from the registration; never listed until they say so */
+  const p = await updateRepoJson(proj.repo, proj.branch || 'main', mmPeoplePath(summit), d => {
+    d.docs = d.docs && typeof d.docs === 'object' && !Array.isArray(d.docs) ? d.docs : {};
+    if (!d.docs[id]) d.docs[id] = { name: `${person.first} ${person.last}`.trim(), title: person.title, company: person.company, about: '', linkedin: '', listed: false, blocked: [], joined: now, at: now };
+    return d;
+  }, 'MyMISMO attendee signed in');
+  if (!p || p.error) return respond(502, { error: 'UNAVAILABLE', message: 'Sign-in is briefly unavailable. Please try again in a minute.' });
+  const end = Date.parse(s.last + 'T00:00:00Z'), exp = Math.floor(Math.min(Number.isFinite(end) ? end + 4 * 86_400_000 : now + 45 * 86_400_000, now + 45 * 86_400_000) / 1000);
