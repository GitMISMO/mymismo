+  const id = mmIdOf(summit, email), code = String(randomInt(0, 1_000_000)).padStart(6, '0');
+  const w = await updateRepoJson(proj.repo, proj.branch || 'main', MM_CODES, d => {
+    d.docs = d.docs && typeof d.docs === 'object' && !Array.isArray(d.docs) ? d.docs : {};
+    for (const [k, v] of Object.entries(d.docs)) if (!v || !(v.exp > now - 86_400_000)) delete d.docs[k];   /* tidy: a day after expiry */
+    d.docs[id] = { h: mmHash(code), exp: now + MM_CODE_TTL_MS, tries: 0, s: summit };
+    return d;
+  }, 'MyMISMO sign-in code');
+  if (!w || w.error) return respond(502, { error: 'UNAVAILABLE', message: 'Sign-in is briefly unavailable. Please try again in a minute.' });
+  const first = person.first || 'there';
+  const t = `Hello ${first},\n\nYour MyMISMO sign-in code is ${code}. It works once, for 15 minutes.\n\nIf you didn’t ask for it, you can ignore this email.\n\nMISMO`;
+  await sendMail({ kind: 'mymismo-code', to: email, subject: `${code} is your MyMISMO sign-in code`, text: t, html: htmlOf(t) }).catch(e => console.warn('mymismo code mail:', e && e.message));
+  return fine;
+}
