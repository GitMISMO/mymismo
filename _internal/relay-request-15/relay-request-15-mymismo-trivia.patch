+/* =====================================================================================
+ * MYMISMO TRIVIA: MONTHLY LEADERBOARD AND QUARTERLY CHAMPIONSHIP (relay request 15; Jonna Critchley, Nov 25, 2026)
+ * Builds on relay requests 13 and 14 (the same mymismo entry in projects.json and the same private mymismo-data).
+ *
+ * Rules Jonna decided (Nov 25, 2026):
+ *  - The leaderboard starts over on the 1st of every month (Eastern time). It ranks each player's single best round,
+ *    and only Hard rounds of Mixed questions count.
+ *  - Each quarter the three monthly champions play a Championship Board. If someone wins two months of the quarter,
+ *    the later month's next-highest player takes the spot.
+ *  - Finalists play on their own phone during a set window. Once they start, a set time runs on the server: one try,
+ *    no pausing, no restarting.
+ *  - Anyone can sign in to play with a six-digit code emailed to them (Jonna, Nov 25, 2026). The board shows the name
+ *    they give as first name and last initial.
+ *
+ * The answers never leave the relay until a question is answered: the bank (with answers) is in the PRIVATE
+ * mymismo-data, questions are handed out one at a time with the choices shuffled here, and every answer is timed here.
+ *
+ *   GET  /mymismo/trivia/ready                       -> { ok, month, quarter, secs, champ }          (no sign-in)
+ *   POST /mymismo/trivia/code    { email, startedAt, website }   -> { ok }   (emails a sign-in code; same answer always)
+ *   POST /mymismo/trivia/verify  { email, code, first, last }    -> { token, me: { id, name }, expiresAt }
+ *   POST /mymismo/trivia/round                       -> { round, count: 10, secs: 15 }              (player)
+ *   POST /mymismo/trivia/next    { round }           -> { n, cat, q, choices, secs }               (player)
+ *   POST /mymismo/trivia/answer  { round, n, choice } -> { right, answer, points, streak, total, done, best }   (player)
+ *   GET  /mymismo/trivia/board?month=YYYY-MM          -> { month, rows: [{ rank, name, score, right }], me? }
+ *   GET  /mymismo/trivia/champ                        -> { quarter, opens, closes, minutes, open, finalists, standings? }
+ *   POST /mymismo/trivia/champ/start                  -> { cats, values, deadline }                 (finalist, once)
+ *   POST /mymismo/trivia/champ/pick   { cell }        -> { cell, cat, value, q, choices, left }     (finalist)
+ *   POST /mymismo/trivia/champ/answer { cell, choice } -> { right, answer, points, total, left, done } (finalist)
+ *   POST /mymismo/trivia/delete                       -> { ok }   (player: removes their name, every score they ever
+ *                                                        posted and their question history; the app stores need this for
+ *                                                        any app that lets people make an account)
+ *
+ * Where things live (mymismo-data, outside its writable and readable folders):
+ *   trivia/questions.json      { questions: [{ id, cat, q, choices[4], answer, level, source, champ? }] }  (the approved set)
+ *   trivia/codes.json          { docs: { <player id>: { h, exp, tries } } }
+ *   trivia/players.json        { docs: { <player id>: { name, joined, at } } }   (no email is kept)
+ *   trivia/rounds.json         { docs: { <round>: { p, ids[], perm[], at[], right[], pts[], streak, total, started } } }
+ *   trivia/seen.json           { docs: { <player id>: [question ids, newest last, 400 at most] } }
+ *   trivia/board-YYYY-MM.json  { docs: { <player id>: { name, best, right, at, rounds } } }
+ *   trivia/champ-YYYY-Qn.json  { finalists: [{ p, name, month }], docs: { <player id>: { start, deadline, cells, open, total } } }
+ * A player id is the first 16 hex characters of sha-256("mymismo-player:<email>").
+ *
+ * Settings, in projects.json's mymismo entry: "trivia": true switches every route on (404 NOT_FOUND until then), and
+ * "triviaChamp": { "quarter": "2027-Q1", "opens": ISO time, "closes": ISO time, "minutes": 15 } sets the championship.
+ * Limits per running copy: codes 5 an hour from one address, 3 an hour to one email, 300 an hour in all; verify 20 an
+ * hour from one address (a code is spent after 5 wrong tries); rounds 30 an hour and answers 600 an hour per player;
+ * board and champ reads 600 an hour from one address. The only email sent is the sign-in code, to the person who
+ * asked for it (kind mymismo-trivia-code, through the same mail flow).
+ * ===================================================================================== */
+const MM15 = { codes: 'trivia/codes.json', players: 'trivia/players.json', bank: 'trivia/questions.json', rounds: 'trivia/rounds.json', seen: 'trivia/seen.json' };
+const MM15_LIMITS = { code: 5, codeEmail: 3, codeAll: 300, verify: 20, round: 30, answer: 600, read: 600, champ: 120 };
+const MM15_SECS = 15, MM15_MULT = 2, MM15_COUNT = 10, MM15_NET_MS = 1000, MM15_ROUND_TTL = 3_600_000;
