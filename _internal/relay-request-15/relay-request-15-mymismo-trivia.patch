+/* --- the quarterly championship --- */
+async function mm15Finalists(proj, quarter) {
+  const ranks = [];
+  for (const m of mm15MonthsOf(quarter)) {
+    const r = await readFile(proj.repo, proj.branch || 'main', mm15Board(m)); if (r.status !== 200 && r.status !== 404) return null;
