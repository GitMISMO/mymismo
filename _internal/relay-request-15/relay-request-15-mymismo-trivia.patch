+/* --- ranked rounds: 10 Hard questions, Mixed (every category once before any twice, none more than twice) --- */
+function mm15Pick(qs, seen, count) {
+  const hard = qs.filter(q => Number(q.level) === 3 && !q.champ), have = new Set(seen);
