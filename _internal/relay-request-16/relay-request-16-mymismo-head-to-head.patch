+      g.sent = now;
+    } else if (g.b === who.id && g.status === 'theirs' && !g.bScore) {
+      g.bScore = score; g.status = 'done'; g.ended = now;
+      const A = g.aScore || { total: 0, ms: 0 };
+      g.winner = A.total !== score.total ? (A.total > score.total ? 'a' : 'b') : (A.ms !== score.ms ? (A.ms < score.ms ? 'a' : 'b') : 'tie');
