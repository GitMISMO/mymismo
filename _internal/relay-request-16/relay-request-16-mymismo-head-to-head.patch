+  if (g.status === 'done') { out.them = theirScore ? { total: theirScore.total, right: theirScore.right } : null; out.result = g.winner === 'tie' ? 'tie' : (g.winner === (mine ? 'a' : 'b') ? 'won' : 'lost'); }
