+const MM16_GAME = /^H[0-9a-z]{6,20}$/;
+function mm16Tidy(docs, now) {   /* expire on read; drop finished games after 30 days */
+  for (const [k, g] of Object.entries(docs)) {
+    if (!g || typeof g !== 'object') { delete docs[k]; continue; }
+    if (g.status === 'first' && now - g.made > MM16_FIRST_TTL) { delete docs[k]; continue; }   /* the starter never finished */
+    if ((g.status === 'theirs' || g.status === 'open') && now > g.exp) { g.status = 'expired'; g.ended = now; }
+    if (['done', 'declined', 'expired'].includes(g.status) && now - (g.ended || g.made) > MM16_KEEP) delete docs[k];
+  }
+  return docs;
+}
+function mm16View(id, g, me) {
+  const mine = g.a === me, other = mine ? { id: g.b, name: g.bName } : { id: g.a, name: g.aName };
+  const myScore = mine ? g.aScore : g.bScore, theirScore = mine ? g.bScore : g.aScore;
+  let state = g.status;
+  if (g.status === 'theirs') state = mine ? 'waiting' : 'your-turn';
+  if (g.status === 'open') state = 'waiting';
+  if (g.status === 'first') state = mine ? 'playing' : 'waiting';
+  const out = { id, mode: g.mode, state, opponent: other.name || null, made: new Date(g.made).toISOString(), expires: g.exp ? new Date(g.exp).toISOString() : null,
